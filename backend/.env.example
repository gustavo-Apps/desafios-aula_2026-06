# Variáveis de ambiente — copie este arquivo para .env e preencha

# Servidor
PORT=3000
NODE_ENV=development # Altere para "production" em produção

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=weekly_reports
DB_USER=root
DB_PASS=sua_senha_aqui

# Pasta onde os relatórios .md serão salvos (relativo à raiz do projeto)
REPORTS_DIR=reports/generated
